<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Darknet Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div style="padding: 40px; max-width: 700px; margin: 0 auto;">

  <div style="margin-bottom: 32px;">
    <span class="badge badge--ok">DOSTĘP PRZYZNANY</span>
    <h1 style="margin-top:12px; font-size: 3rem;">DARKNET_OS</h1>
    <p style="color:var(--amber-dim); font-size:0.85rem; margin-top:4px;">Sesja aktywna &nbsp;|&nbsp; Protokół szyfrowania: AES-256</p>
  </div>

  <div class="panel panel--wide">
    <div class="panel-header">
      <span class="dot active"></span>
      <span class="dot active"></span>
      <span class="dot"></span>
      <span style="margin-left:8px; font-size:0.75rem; letter-spacing:0.14em; color:var(--amber-dim);">MENU GŁÓWNE</span>
    </div>

    <p class="prompt" style="margin-bottom:16px;">Wybierz zadanie operacyjne:</p>

    <ul class="nav-list">
      <li>
        <a href="/level-1">1&nbsp;&nbsp;Infiltracja kodu</a>
        &nbsp;<span class="badge badge--warn" style="font-size:0.65rem;">POZIOM&nbsp;1</span>
      </li>
    </ul>

    <hr class="divider">

    <a href="/logout" class="btn btn--danger" style="font-size:0.78rem;">ZAKOŃCZ SESJĘ</a>
  </div>

  <p style="margin-top:20px; font-size:0.72rem; color:var(--amber-dim);">
    &copy; DARKNET INVESTIGATION &nbsp;|&nbsp; Wszelkie prawa zastrzeżone operacyjnie.
  </p>
</div>
</body>
</html>
