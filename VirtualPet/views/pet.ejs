<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pet.name %> - Virtual Pet</title>
</head>
<body>
  <div>
    <h1><%= pet.name %></h1>
    <div>
      <% if (pet.hunger <= 0) { %>
        <p>Twój zwierzak jest bardzo głodny!</p>
      <% } else if (pet.energy <= 0) { %>
        <p>Twój zwierzak jest wyczerpany!</p>
      <% } else { %>
        <p>Twój zwierzak czuje się dobrze!</p>
      <% } %>
    </div>
    <div>
      <div>
        <div>
          <span>Głód</span>
          <span><%= pet.hunger %>%</span>
        </div>
        <div>
          <div style="width: <%= pet.hunger %>%;"></div>
        </div>
      </div>
      <div>
        <div>
          <span>Szczęście</span>
          <span><%= pet.happiness %>%</span>
        </div>
        <div>
          <div style="width: <%= pet.happiness %>%;"></div>
        </div>
      </div>
      <div>
        <div>
          <span>Energia</span>
          <span><%= pet.energy %>%</span>
        </div>
        <div>
          <div style="width: <%= pet.energy %>%;"></div>
        </div>
      </div>
    </div>
    <div>
      <form action="/pet/feed" method="POST">
        <button type="submit" >Nakarm</button>
      </form>
      <form action="/pet/play" method="POST">
        <button type="submit">Zagraj</button>
      </form>
      <form action="/pet/sleep" method="POST">
        <button type="submit">Śpij</button>
      </form>
    </div>
    <form action="/auth/logout" method="GET">
      <button type="submit">Wyloguj się</button>
    </form>
  </div>
</body>
</html>